{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "cloudflare-relay",
  "name": "Cloudflare Relay Setup",
  "version": "1.2.0",
  "description": "Generate a compatible Orca relay deployment configuration for Cloudflare Workers.",
  "author": { "name": "truongthanhquan" },
  "repository": "https://github.com/truongthanhquan/orca-cloudflare-relay-plugin",
  "license": "MIT",
  "engines": { "orca": ">=1.4.246" },
  "pluginApi": 1,
  "main": "src/main.mjs",
  "contributes": {
    "panels": [
      { "id": "cloudflare-relay", "title": "Cloudflare Relay", "icon": "cloud", "entry": "panel.html" }
    ],
    "commands": [
      { "id": "cloudflare-relay.generate", "title": "Cloudflare Relay: Generate deployment config" },
      { "id": "cloudflare-relay.validate", "title": "Cloudflare Relay: Validate deployment settings" }
    ],
    "settings": [
      {
        "key": "relayDomain",
        "title": "Relay director hostname",
        "description": "Your public HTTPS hostname, for example relay.example.com. It should point to the Cloudflare Worker.",
        "type": "string",
        "placeholder": "relay.example.com",
        "maxLength": 253
      },
      {
        "key": "authIssuer",
        "title": "Relay auth issuer",
        "description": "The HTTPS issuer used by Orca Cloud relay JWTs. Usually https://login.onorca.dev for the hosted Orca authentication service.",
        "type": "string",
        "default": "https://login.onorca.dev",
        "placeholder": "https://login.onorca.dev",
        "maxLength": 2048
      },
      {
        "key": "jwksUrl",
        "title": "Relay JWKS URL",
        "description": "Public JWKS URL of the relay auth issuer. Usually https://login.onorca.dev/.well-known/jwks.json.",
        "type": "string",
        "default": "https://login.onorca.dev/.well-known/jwks.json",
        "placeholder": "https://login.onorca.dev/.well-known/jwks.json",
        "maxLength": 2048
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "secrets:own" }
  ]
}
